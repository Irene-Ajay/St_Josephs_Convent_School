# Copy this file to .env and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# .env is git-ignored. Never commit real keys.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# The "anon" / "publishable" key. This one is safe to use in the browser
# because Row Level Security blocks everything until a staff member signs in.
# Do NOT put the service_role / secret key here - it bypasses all security.
SUPABASE_ANON_KEY=
